{
  "name": "button-sounds-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.1.4",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm --filter button-sounds build && pnpm --filter site build",
    "dev": "run-p dev:pkg dev:site",
    "dev:pkg": "pnpm --filter button-sounds dev",
    "dev:site": "pnpm --filter site dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:pkg": "pnpm --filter button-sounds lint:pkg",
    "convert-audio": "node scripts/convert-audio.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "pnpm --filter button-sounds storybook",
    "build-storybook": "pnpm --filter button-sounds build-storybook"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0"
  }
}
